*********************************************************************
*
* Sound
*
* The MSX version plays the ayFX bank in msx/fullsfx.afb on the
* AY-3-8910.  tools/conv_sfx.py reads that bank and writes src/sfx.a99,
* so these are the same ten effects with the same envelopes, mapped to
* the SN76489: tone periods carry over unchanged, volumes become
* attenuations, and frame counts are stretched by 6/5 because the MSX
* plays them at 50 Hz and the TI runs at 60.
*
* The effect data is too big for bank 0 and lives in bank 2, so every
* read goes through sfxrd in the shared segment.
*
* Callers beware: this code uses r0 to r4 as scratch.
*
* An effect is a channel followed by a list of steps:
*
*   data  channel            0-2 tone, 3 noise
*   data  frequency          divider, or noise mode on channel 3
*   byte  attenuation, frames
*   ...
*   data  0                  end of the effect
*
*********************************************************************

sndptr equ  sndvar+0                   ; Current step, 0 when silent
sndchn equ  sndvar+2                   ; Channel of the running effect
snddur equ  sndvar+4                   ; Frames left on this step

*********************************************************************
*
* Silence every channel
*
sndini:
       li   r1,>9f00                   ; Attenuation 15 on all four
       movb r1,@sound
       li   r1,>bf00
       movb r1,@sound
       li   r1,>df00
       movb r1,@sound
       li   r1,>ff00
       movb r1,@sound
       clr  @sndptr
       rt
*// sndini

*********************************************************************
*
* Start a sound effect
*
* r1: effect number
*
sfxini:
       mov  r11,*r10+
       sla  r1,1
       mov  @sfxtab(r1),r1
       bl   @sfxrdw                    ; Channel, from the effect bank
*      ayFX plays everything on one channel, these effects pick a tone
*      or the noise channel, so an effect that lands on a different
*      channel has to silence the one that was playing, or it drones on
       mov  @sndptr,r0
       jeq  sfxin1
       c    r2,@sndchn
       jeq  sfxin1
       mov  @sndchn,r0
       sla  r0,5
       ori  r0,>009f                   ; Attenuation 15
       swpb r0
       movb r0,@sound
sfxin1:
       mov  r2,@sndchn
       mov  r1,@sndptr
       clr  r0
       movb r0,@snddur
       dect r10
       mov  *r10,r11
       b    @sndstp                    ; Play the first step right away
*// sfxini

*********************************************************************
*
* Called once per frame
*
sndply:
       mov  @sndptr,r1
       jeq  sndpl9
       movb @snddur,r0
       jeq  sndstp
       srl  r0,8
       dec  r0
       sla  r0,8
       movb r0,@snddur
sndpl9:
       rt
*
* Play the next step of the running effect
*
sndstp:
       mov  r11,*r10+
       mov  @sndptr,r1
       bl   @sfxrd                     ; r2 = frequency, r0 = level and frames
       mov  r2,r2
       jne  sndst1
*      End of the effect: silence the channel
       clr  @sndptr
       mov  @sndchn,r3
       sla  r3,5
       ori  r3,>009f                   ; Attenuation 15
       swpb r3
       movb r3,@sound
       jmp  sndst4
sndst1:
       mov  r1,@sndptr
       mov  r0,r4                      ; Keep the level and frames
       mov  @sndchn,r3
       ci   r3,3
       jeq  sndst2
*      Tone: two bytes, low four bits first
       mov  r2,r0
       andi r0,>000f
       mov  r3,r1
       sla  r1,5
       a    r1,r0
       ori  r0,>0080
       swpb r0
       movb r0,@sound
       mov  r2,r0
       srl  r0,4
       andi r0,>003f
       swpb r0
       movb r0,@sound
       jmp  sndst3
sndst2:
*      Noise: one byte
       mov  r2,r0
       andi r0,>0007
       ori  r0,>00e0
       swpb r0
       movb r0,@sound
sndst3:
*      Attenuation and duration
       mov  r4,r0
       srl  r0,8
       andi r0,>000f
       mov  r3,r1
       sla  r1,5
       a    r1,r0
       ori  r0,>0090
       swpb r0
       movb r0,@sound
       swpb r4
       movb r4,@snddur
sndst4:
       dect r10
       mov  *r10,r11
       rt
*// sndply

*********************************************************************
*
* The effects
*
sfxtab data sfx0,sfx1,sfx2,sfx3,sfx4
       data sfx5,sfx6,sfx7,sfx8,sfx9
