*********************************************************************
*
* Sound
*
* The MSX version uses the AY-3-8910 with the ayFX effect player and
* PT3 music.  Neither can be reused on the TI-99/4A, which has an
* SN76489: three square wave channels and one noise channel, no
* envelopes and no volume ramp per channel other than the four bit
* attenuation.  The effects below are therefore written from scratch
* for the SN76489, one effect at a time, in the same places in the
* game as the ayFX effects of the original.
*
* An effect is a channel followed by a list of steps:
*
*   data  channel            0-2 tone, 3 noise
*   data  frequency          divider, or noise mode on channel 3
*   byte  attenuation, frames
*   ...
*   data  0                  end of the effect
*
*********************************************************************

sndptr equ  sndvar+0                   ; Current step, 0 when silent
sndchn equ  sndvar+2                   ; Channel of the running effect
snddur equ  sndvar+4                   ; Frames left on this step

*********************************************************************
*
* Silence every channel
*
sndini:
       li   r1,>9f00                   ; Attenuation 15 on all four
       movb r1,@sound
       li   r1,>bf00
       movb r1,@sound
       li   r1,>df00
       movb r1,@sound
       li   r1,>ff00
       movb r1,@sound
       clr  @sndptr
       rt
*// sndini

*********************************************************************
*
* Start a sound effect
*
* r1: effect number
*
sfxini:
       sla  r1,1
       mov  @sfxtab(r1),r1
       mov  *r1+,r2
       mov  r2,@sndchn
       mov  r1,@sndptr
       clr  r0
       movb r0,@snddur
       b    @sndstp                    ; Play the first step right away
*// sfxini

*********************************************************************
*
* Called once per frame
*
sndply:
       mov  @sndptr,r1
       jeq  sndpl9
       movb @snddur,r0
       jeq  sndstp
       srl  r0,8
       dec  r0
       sla  r0,8
       movb r0,@snddur
sndpl9:
       rt
*
* Play the next step of the running effect
*
sndstp:
       mov  @sndptr,r1
       mov  *r1+,r2                    ; Frequency
       jne  sndst1
*      End of the effect: silence the channel
       clr  @sndptr
       mov  @sndchn,r3
       sla  r3,5
       ori  r3,>009f                   ; Attenuation 15
       swpb r3
       movb r3,@sound
       rt
sndst1:
       mov  @sndchn,r3
       ci   r3,3
       jeq  sndst2
*      Tone: two bytes, low four bits first
       mov  r2,r0
       andi r0,>000f
       mov  r3,r4
       sla  r4,5
       a    r4,r0
       ori  r0,>0080
       swpb r0
       movb r0,@sound
       mov  r2,r0
       srl  r0,4
       andi r0,>003f
       swpb r0
       movb r0,@sound
       jmp  sndst3
sndst2:
*      Noise: one byte
       mov  r2,r0
       andi r0,>0007
       ori  r0,>00e0
       swpb r0
       movb r0,@sound
sndst3:
*      Attenuation and duration
       movb *r1,r0
       srl  r0,8
       andi r0,>000f
       mov  r3,r4
       sla  r4,5
       a    r4,r0
       ori  r0,>0090
       swpb r0
       movb r0,@sound
       movb @1(r1),r0
       movb r0,@snddur
       inct r1
       mov  r1,@sndptr
       rt
*// sndply

*********************************************************************
*
* The effects
*
sfxtab data sfx0,sfx1,sfx2,sfx3,sfx4
       data sfx5,sfx6,sfx7,sfx8

*
* Eat a dot: a short high blip
*
sfx0   data 2
       data 180
       byte 4,1
       data 140
       byte 6,1
       data 0

*
* Eat an energizer: a fast sweep down
*
sfx1   data 2
       data 120
       byte 2,2
       data 180
       byte 3,2
       data 250
       byte 4,2
       data 340
       byte 6,2
       data 0

*
* Eat a monster: a rising arpeggio
*
sfx2   data 2
       data 480
       byte 2,2
       data 380
       byte 2,2
       data 300
       byte 2,2
       data 240
       byte 2,3
       data 190
       byte 4,3
       data 0

*
* Death: a long fall
*
sfx3   data 2
       data 160
       byte 0,4
       data 200
       byte 1,4
       data 260
       byte 2,4
       data 330
       byte 3,5
       data 420
       byte 4,5
       data 540
       byte 5,6
       data 700
       byte 7,8
       data 900
       byte 10,10
       data 0

*
* Level finished
*
sfx4   data 2
       data 480
       byte 2,4
       data 380
       byte 2,4
       data 320
       byte 2,4
       data 240
       byte 2,8
       data 190
       byte 3,8
       data 160
       byte 4,12
       data 0

*
* Level start
*
sfx5   data 2
       data 320
       byte 2,6
       data 240
       byte 2,6
       data 190
       byte 2,6
       data 160
       byte 3,12
       data 0

*
* Menu cursor
*
sfx6   data 2
       data 300
       byte 4,2
       data 0

*
* Tooth brush: a short scrub of noise
*
sfx7   data 3
       data 6                          ; White noise, medium
       byte 6,2
       data 6
       byte 10,2
       data 0

*
* Bonus and extra life
*
sfx8   data 2
       data 340
       byte 3,2
       data 250
       byte 3,2
       data 190
       byte 3,2
       data 160
       byte 3,4
       data 0
