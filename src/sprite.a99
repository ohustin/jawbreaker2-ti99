*********************************************************************
*
* Sprite engine
*
* Straight port of msx/sprites.asm.  Two kinds of sprites exist:
*
*  - "descriptor" sprites (the player, the tooth brush, the logo).
*    A descriptor lists one or more 16x16 sprites with an offset, a
*    colour and the address of a 32 byte pattern.  The pattern is
*    streamed into the sprite generator table every frame, which is
*    how the MSX version animates the player without keeping every
*    frame in VRAM.
*
*  - monster sprites.  Their patterns are pre-loaded by setmst and the
*    pattern number is calculated from the monster position, so that
*    the mouth animates as the monster crosses the screen.
*
* Descriptor layout (word aligned for the TMS9900):
*    data  number of sprites
*    byte  y offset, x offset, colour, 0
*    data  pattern address (bank 1)
*    ...
*
*********************************************************************

*********************************************************************
*
* Start a new sprite list
*
initspr:
       li   r0,tas
       mov  r0,@tasptr
       li   r0,tgs
       mov  r0,@tgsptr
       clr  r0
       movb r0,@tascnt
       rt
*// initspr

*********************************************************************
*
* Draw a descriptor sprite
*
* r6: descriptor address
* r3: x
* r4: y
*
putspr:
       mov  r11,*r10+
       mov  r6,*r10+                   ; Keep the descriptor for pass two
       mov  *r6+,r7
       mov  r7,*r10+
*      Pass one: the attributes.  They are consecutive in VRAM, so the
*      write address is set once and the VDP does the rest.  This is
*      the part that has to be over before the raster starts drawing.
       mov  @tasptr,r0
       bl   @vwad
putsp1:
       movb *r6,r5                     ; y
       srl  r5,8
       a    r4,r5
       dec  r5
       andi r5,>00ff
       swpb r5
       movb r5,*r15
       movb @1(r6),r5                  ; x
       srl  r5,8
       a    r3,r5
       ci   r5,255
       jle  putsp2
       li   r5,255                     ; Off screen to the right
putsp2:
       swpb r5
       movb r5,*r15
       movb @tascnt,r5                 ; Pattern number
       movb r5,*r15
       ab   @cst4,@tascnt
       movb @2(r6),r5                  ; Colour
       movb r5,*r15
       inct @tasptr
       inct @tasptr
       ai   r6,6
       dec  r7
       jne  putsp1
       dect r10
       mov  *r10,r7
       dect r10
       mov  *r10,r6
       dect r10
       mov  *r10,r11
       b    *r11
*// putspr

*********************************************************************
*
* Send the patterns of a descriptor sprite to the generator table
*
* r6: the same descriptor that was given to putspr
*
* This runs after the whole sprite list has been written, because the
* attributes are what has to be in place before the raster starts.
* Nothing has to be sent again while the animation frame stays the
* same, which it does on seven frames out of eight.
*
putpat:
       mov  r11,*r10+
       mov  *r6,r7                     ; Number of sprites
       c    r6,@lastsp
       jeq  putsp5
       mov  r6,@lastsp
       inct r6                         ; Past the count
putsp3:
       mov  @tgsptr,r0
       mov  @4(r6),r1
       bl   @b1pat
       li   r5,32
       a    r5,@tgsptr
       ai   r6,6
       dec  r7
       jne  putsp3
       jmp  putsp6
putsp5:
       li   r5,32                      ; The patterns are already there,
putsp4:                                ; only move the pointer on
       a    r5,@tgsptr
       dec  r7
       jne  putsp4
putsp6:
       dect r10
       mov  *r10,r11
       b    *r11
cst4   byte 4
       even
*// putpat

*********************************************************************
*
* Draw a monster, two overlapping sprites
*
* r6: monster record
* r3: x (low byte of the 16 bit position)
* r4: y
* r8: 0 for a normal monster, 32 when the monster is in the left
*     hand exit area and has to be drawn with the early clock bit
*
putmst:
       mov  r11,*r10+
*      Pattern number of the first layer, the second is four on
       movb @3(r6),r5
       srl  r5,8
       andi r5,15
       ci   r5,seaten
       jeq  putms1
       bl   @mstnpt                    ; Alive: the walk animation
       jmp  putms2
putms1:
       bl   @mstept                    ; Eaten: spinning, or the score
putms2:
*      Colours: the monster colour with a white layer on top
       movb @5(r6),r0
       srl  r0,8
       li   r7,15
       movb @3(r6),r1
       srl  r1,8
       ci   r1,sscare
       jne  putms3
       bl   @mstsc2                    ; Scared: blue, blinking when the
putms3:                                ; energizer is running out
       andi r1,15
       ci   r1,seaten
       jne  putms4
       li   r0,4
putms4:
       mov  r8,r8                      ; Early clock bit for the left exit
       jeq  putms5
       ori  r0,>0080
       ori  r7,>0080
putms5:
*      Both attribute entries, eight bytes, no address setup needed
       mov  r4,r1
       dec  r1
       andi r1,>00ff
       swpb r1
       mov  r3,r2
       a    r8,r2
       andi r2,>00ff
       swpb r2
       swpb r0
       swpb r7
       movb r1,*r15                    ; y, x, pattern, colour
       movb r2,*r15
       swpb r5
       movb r5,*r15
       movb r0,*r15
       movb r1,*r15                    ; and the white layer
       movb r2,*r15
       swpb r5
       ai   r5,4
       swpb r5
       movb r5,*r15
       movb r7,*r15
       li   r0,8
       a    r0,@tasptr
       ab   @cst8,@tascnt
       dect r10
       mov  *r10,r11
       b    *r11
cst8   byte 8
       even
*// putmst

*********************************************************************
*
* Close the sprite list, once, after everything has been drawn
*
endspr:
       mov  r11,*r10+
       mov  @tasptr,r0
       li   r1,>d000                   ; y = 208 stops the VDP
       bl   @vsbw
       dect r10
       mov  *r10,r11
       b    *r11
*// endspr

*
* Pattern number for a monster that is alive: the frame follows the x
* position so that the monster chews while it moves
*
mstnpt:
       mov  r11,r9
       clr  r2
       mov  r3,r5
       neg  r5
       andi r5,>00ff
       movb @level,r1                  ; Every third level the monsters
       srl  r1,8                       ; bounce back and forth instead of
       andi r1,3                       ; wrapping around
       ci   r1,2
       jne  mstnp1
       mov  r5,r1
       andi r1,>0040
       jeq  mstnp1
       inv  r5
       andi r5,>00ff
mstnp1:
       srl  r5,2
       andi r5,15
       sla  r5,3
       a    r2,r5
       andi r5,>007f
       ai   r5,mstnrm
       b    *r9
*// mstnpt

*
* Pattern number for a monster that has been eaten
*
mstept:
       mov  r11,r9
       movb @8(r6),r5                  ; Scare timer
       srl  r5,8
       ci   r5,175
       jhe  mstep2                     ; Just eaten: show the bonus value
       mov  @timer,r5
       andi r5,>00ff
       srl  r5,2
       sla  r5,3
       andi r5,>003f
       ai   r5,mstetn
       b    *r9
mstep2:
       movb @3(r6),r5                  ; Multiplier in the high nibble
       srl  r5,8
       srl  r5,1
       andi r5,>0038
       ai   r5,-8
       ai   r5,mst100
       b    *r9
*// mstept

*
* Scared monsters are blue, and blink between blue and their own
* colour when the energizer is about to run out
*
mstsc2:
       li   r0,4                       ; Blue
       movb @scrtim,r9
       srl  r9,8
       ci   r9,100
       jhe  mstsc1
       andi r9,4
       jeq  mstsc1
       movb @5(r6),r0                  ; Blink back to the real colour
       srl  r0,8
mstsc1:
       rt
*// mstsc2

*********************************************************************
*
* Sprite descriptors
*
jaw1   data 2
       byte 0,0,6,0
       data jawtgs1_6
       byte 0,0,15,0
       data jawtgs1_15

jaw2   data 2
       byte 0,0,6,0
       data jawtgs2_6
       byte 0,0,15,0
       data jawtgs2_15

jawv1  data 2
       byte 0,0,6,0
       data jawtgsv1_6
       byte 0,0,15,0
       data jawtgsv1_15

jawv2  data 2
       byte 0,0,6,0
       data jawtgsv2_6
       byte 0,0,15,0
       data jawtgsv2_15

jawdt1 data 1
       byte 0,0,6,0
       data jawtgs1_6

jawdt2 data 1
       byte 0,0,15,0
       data jawtgs1_15

tbrush data 2
       byte 0,0,8,0
       data tgssp28l0
       byte 0,32,8,0
       data tgssp29l0

tbrsh2 data 2
       byte 0,0,8,0
       data tgssp28l0
       byte 0,16,8,0
       data tgssp29l0

logo   data 2
       byte 0,0,4,0
       data abysslogogfx1
       byte 0,0,15,0
       data abysslogogfx2
